# Copy to .env and fill in real values. Never commit .env.
# All of these are optional — the site degrades gracefully without them.

# GitHub username only (enables the live GitHub section)
VITE_GITHUB_USERNAME=

# Full LinkedIn profile URL (enables LinkedIn buttons)
VITE_LINKEDIN_URL=

# Public contact email (enables mailto links and the contact form fallback)
VITE_CONTACT_EMAIL=

# Optional POST endpoint for the contact form (Formspree / EmailJS / custom API).
# When empty, the form falls back to opening the visitor's email client.
VITE_CONTACT_ENDPOINT=

# Override the base path (defaults to /prince-portfolio/ in production builds)
# VITE_BASE=/
